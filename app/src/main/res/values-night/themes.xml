<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================
         Dark Theme Overrides
         All colors reference values-night/colors.xml via resource names
         ================================================================ -->
    <style name="Theme.CommCons" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Material color roles - night values from values-night/colors.xml -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/sl_header_bg</item>
        <item name="android:navigationBarColor">@color/sl_background</item>
        <item name="android:windowBackground">@color/sl_background</item>

        <!-- Custom semantic attrs (night values) -->
        <item name="screenBackground">@color/sl_background</item>
        <item name="cardBackground">@color/sl_surface</item>
        <item name="headerBackground">@color/sl_header_bg</item>
        <item name="primaryText">@color/sl_text_primary</item>
        <item name="secondaryText">@color/sl_text_secondary</item>
        <item name="mutedText">@color/sl_text_secondary</item>
        <item name="strokeColor">@color/sl_stroke</item>

        <!-- Legacy attr aliases -->
        <item name="accentCyan">@color/sl_accent_saffron</item>
        <item name="accentGreen">@color/sl_accent_green</item>
        <item name="accentOrange">@color/sl_accent_saffron</item>
        <item name="accentYellow">@color/sl_accent_saffron</item>
        <item name="buttonBackground">@color/sl_btn_primary</item>
        <item name="inputBackground">@drawable/rounded_input_dark</item>

        <!-- Priority chip attrs (dark) -->
        <item name="chipPriorityHighBg">@color/sl_priority_high_bg</item>
        <item name="chipPriorityHighText">@color/sl_priority_high</item>
        <item name="chipPriorityMediumBg">@color/sl_priority_medium_bg</item>
        <item name="chipPriorityMediumText">@color/sl_priority_medium</item>
        <item name="chipPriorityLowBg">@color/sl_priority_low_bg</item>
        <item name="chipPriorityLowText">@color/sl_priority_low</item>
    </style>

</resources>