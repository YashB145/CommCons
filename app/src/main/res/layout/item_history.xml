<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeWidth="@dimen/card_stroke"
    app:strokeColor="?attr/strokeColor"
    app:cardBackgroundColor="?attr/cardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Title + Priority chip row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/primaryText"
                android:layout_marginEnd="@dimen/spacing_sm"/>

            <!-- Priority chip: color set by Kotlin setTextColor -->
            <TextView
                android:id="@+id/tvHistoryPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/sl_priority_high"
                android:paddingStart="@dimen/chip_padding_h"
                android:paddingEnd="@dimen/chip_padding_h"
                android:paddingTop="@dimen/chip_padding_v"
                android:paddingBottom="@dimen/chip_padding_v"
                android:background="@drawable/sl_chip_bg"/>
        </LinearLayout>

        <!-- Completed date row (icon replaces emoji) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check"
                android:tint="@color/sl_status_done"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completed: 01 Jan 2025"
                android:textSize="13sp"
                android:textColor="@color/sl_status_done"/>
        </LinearLayout>

        <!-- Location row (icon replaces emoji) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location"
                android:tint="?attr/secondaryText"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tvHistoryLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="13sp"
                android:textColor="?attr/secondaryText"/>
        </LinearLayout>

        <!-- Skills row (icon replaces emoji) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_skills"
                android:tint="?attr/secondaryText"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tvHistorySkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skills"
                android:textSize="13sp"
                android:textColor="?attr/secondaryText"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>