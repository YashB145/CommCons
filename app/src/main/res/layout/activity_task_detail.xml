<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/headerBackground"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_btn_size"
                android:layout_height="@dimen/icon_btn_size"
                android:src="@drawable/ic_back"
                android:tint="@color/sl_text_on_primary"
                android:background="@android:color/transparent"
                android:padding="@dimen/spacing_sm"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/sl_text_on_primary"
                android:layout_marginStart="@dimen/spacing_sm"/>

            <!-- Priority chip in header -->
            <TextView
                android:id="@+id/tvDetailPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/sl_priority_high"
                android:paddingStart="@dimen/chip_padding_h"
                android:paddingEnd="@dimen/chip_padding_h"
                android:paddingTop="@dimen/chip_padding_v"
                android:paddingBottom="@dimen/chip_padding_v"
                android:background="@drawable/sl_chip_bg"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone"/>

        <!-- Detail card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="@dimen/card_stroke"
            app:strokeColor="?attr/strokeColor"
            app:cardBackgroundColor="?attr/cardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <!-- Task title -->
                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Task Title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="?attr/primaryText"
                    android:layout_marginBottom="@dimen/spacing_sm"/>

                <!-- Status -->
                <TextView
                    android:id="@+id/tvDetailStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: OPEN"
                    android:textSize="12sp"
                    android:textColor="@color/sl_status_open"
                    android:layout_marginBottom="@dimen/spacing_lg"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/strokeColor"
                    android:layout_marginBottom="@dimen/spacing_lg"/>

                <!-- Description label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:textColor="?attr/secondaryText"
                    android:layout_marginBottom="@dimen/spacing_sm"/>

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Task description here"
                    android:textSize="15sp"
                    android:textColor="?attr/primaryText"
                    android:layout_marginBottom="@dimen/spacing_lg"/>

                <!-- Location row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        android:tint="?attr/secondaryText"
                        android:layout_marginEnd="@dimen/spacing_sm"/>

                    <TextView
                        android:id="@+id/tvDetailLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textSize="14sp"
                        android:textColor="?attr/secondaryText"/>
                </LinearLayout>

                <!-- Skills row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_xl">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_skills"
                        android:tint="?attr/secondaryText"
                        android:layout_marginEnd="@dimen/spacing_sm"/>

                    <TextView
                        android:id="@+id/tvDetailSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Skills required"
                        android:textSize="14sp"
                        android:textColor="?attr/secondaryText"/>
                </LinearLayout>

                <!-- Accept Task button -->
                <Button
                    android:id="@+id/btnAcceptTask"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Accept task"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/colorPrimary"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:visibility="gone"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <!-- Mark as Done button -->
                <Button
                    android:id="@+id/btnMarkDone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Mark as done"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/sl_priority_low"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:visibility="gone"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <!-- Delete button -->
                <Button
                    android:id="@+id/btnDeleteTask"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Delete task"
                    android:textSize="15sp"
                    android:textColor="@color/sl_priority_high"
                    android:backgroundTint="@color/sl_priority_high_bg"
                    android:visibility="gone"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>