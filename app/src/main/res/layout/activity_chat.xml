<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/screenBackground">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/headerBackground"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:src="@drawable/ic_back"
            android:tint="@color/sl_text_on_primary"
            android:background="@android:color/transparent"
            android:padding="@dimen/spacing_sm"
            android:contentDescription="Back"/>

        <TextView
            android:id="@+id/tvReceiverName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/sl_text_on_primary"
            android:layout_marginStart="@dimen/spacing_sm"/>
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No messages yet. Start the conversation."
        android:textColor="?attr/secondaryText"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:clipToPadding="false"/>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/cardBackground"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message"
            android:background="@drawable/rounded_input_light"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:textColor="?attr/primaryText"
            android:textColorHint="?attr/mutedText"
            android:textSize="15sp"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:layout_marginEnd="@dimen/spacing_sm"/>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_send"
            android:tint="@color/white"
            android:background="@drawable/sl_send_btn_bg"
            android:padding="@dimen/spacing_sm"
            android:contentDescription="Send"/>

    </LinearLayout>
</LinearLayout>