<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/screenBackground">

    <!-- Header - "Smart Match" with neutral icon, no robot emoji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/headerBackground"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:src="@drawable/ic_back"
            android:tint="@color/sl_text_on_primary"
            android:background="@android:color/transparent"
            android:padding="@dimen/spacing_sm"
            android:contentDescription="Back"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_match"
            android:tint="@color/sl_text_on_primary"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Smart Match"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/sl_text_on_primary"/>
    </LinearLayout>

    <!-- Subtitle bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tasks ranked by fit with your skills"
        android:textSize="12sp"
        android:textColor="?attr/secondaryText"
        android:gravity="center"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:background="?attr/screenBackground"/>

    <!-- Loading / status text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finding best matches..."
        android:textSize="14sp"
        android:textColor="?attr/secondaryText"
        android:gravity="center"
        android:padding="@dimen/spacing_xxl"
        android:visibility="visible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatches"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:visibility="gone"/>

</LinearLayout>