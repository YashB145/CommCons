<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/screenBackground">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/headerBackground"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_btn_size"
            android:layout_height="@dimen/icon_btn_size"
            android:src="@drawable/ic_back"
            android:tint="@color/sl_text_on_primary"
            android:background="@android:color/transparent"
            android:padding="@dimen/spacing_sm"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Messages"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/sl_text_on_primary"
            android:layout_marginStart="@dimen/spacing_sm"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No conversations yet"
        android:textColor="?attr/secondaryText"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/spacing_sm"
        android:clipToPadding="false"/>

</LinearLayout>