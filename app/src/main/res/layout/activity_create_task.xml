<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/headerBackground"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_btn_size"
                android:layout_height="@dimen/icon_btn_size"
                android:src="@drawable/ic_back"
                android:tint="@color/sl_text_on_primary"
                android:background="@android:color/transparent"
                android:padding="@dimen/spacing_sm"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Create task"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/sl_text_on_primary"
                android:layout_marginStart="@dimen/spacing_sm"/>
        </LinearLayout>

        <!-- Form container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Title field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/secondaryText"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="e.g. Medical camp volunteers needed"
                android:background="@drawable/rounded_input_light"
                android:paddingStart="@dimen/input_padding_h"
                android:paddingEnd="@dimen/input_padding_h"
                android:textColor="?attr/primaryText"
                android:textColorHint="?attr/mutedText"
                android:textSize="15sp"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <!-- Description field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/secondaryText"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Describe the task, requirements and expected outcome"
                android:background="@drawable/rounded_input_light"
                android:paddingStart="@dimen/input_padding_h"
                android:paddingEnd="@dimen/input_padding_h"
                android:paddingTop="@dimen/spacing_md"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:textColor="?attr/primaryText"
                android:textColorHint="?attr/mutedText"
                android:textSize="15sp"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <!-- Location field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/secondaryText"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="City, area or address (optional)"
                android:background="@drawable/rounded_input_light"
                android:paddingStart="@dimen/input_padding_h"
                android:paddingEnd="@dimen/input_padding_h"
                android:textColor="?attr/primaryText"
                android:textColorHint="?attr/mutedText"
                android:textSize="15sp"
                android:layout_marginBottom="@dimen/spacing_md"/>

            <!-- Skills field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skills required"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/secondaryText"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <EditText
                android:id="@+id/etSkills"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="e.g. teaching, first aid, driving"
                android:background="@drawable/rounded_input_light"
                android:paddingStart="@dimen/input_padding_h"
                android:paddingEnd="@dimen/input_padding_h"
                android:textColor="?attr/primaryText"
                android:textColorHint="?attr/mutedText"
                android:textSize="15sp"
                android:layout_marginBottom="@dimen/spacing_lg"/>

            <!-- Priority label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priority"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?attr/secondaryText"
                android:layout_marginBottom="@dimen/spacing_sm"/>

            <!-- Priority radio group - no emoji, styled plain -->
            <RadioGroup
                android:id="@+id/priorityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_lg">

                <RadioButton
                    android:id="@+id/rbHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High"
                    android:textColor="@color/sl_priority_high"
                    android:buttonTint="@color/sl_priority_high"
                    android:textSize="14sp"
                    android:layout_marginEnd="@dimen/spacing_lg"/>

                <RadioButton
                    android:id="@+id/rbMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    android:checked="true"
                    android:textColor="@color/sl_priority_medium"
                    android:buttonTint="@color/sl_priority_medium"
                    android:textSize="14sp"
                    android:layout_marginEnd="@dimen/spacing_lg"/>

                <RadioButton
                    android:id="@+id/rbLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low"
                    android:textColor="@color/sl_priority_low"
                    android:buttonTint="@color/sl_priority_low"
                    android:textSize="14sp"/>
            </RadioGroup>

            <!-- Submit button -->
            <Button
                android:id="@+id/btnSubmitTask"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Create task"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="@color/colorPrimary"
                android:layout_marginBottom="@dimen/spacing_md"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:indeterminateTint="@color/colorPrimary"
                android:layout_gravity="center_horizontal"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>