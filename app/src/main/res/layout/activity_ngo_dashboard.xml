<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/headerBackground"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NGO Dashboard"
                    android:textSize="12sp"
                    android:textColor="@color/sl_text_on_primary"
                    android:alpha="0.7"/>

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/sl_text_on_primary"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sign out"
                android:textSize="12sp"
                android:textColor="@color/sl_text_on_primary"
                android:backgroundTint="@android:color/transparent"
                android:alpha="0.8"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Stats Row: plain numbers + labels, not rainbow tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">

            <!-- Stat: Tasks -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tvTaskCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/colorPrimary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tasks"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>

            <!-- Stat: Volunteers -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tvVolunteerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/colorPrimary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volunteers"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>

            <!-- Stat: Surveys -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:id="@+id/tvSurveyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/sl_accent_saffron"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Surveys"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Hairline divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/strokeColor"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md"/>

        <!-- Section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actions"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:textColor="?attr/secondaryText"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <!-- Action Rows: icon + title + description style -->

        <!-- Create Task -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_add"
                android:tint="@color/colorPrimary"
                android:layout_marginEnd="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnCreateTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create task"
                    android:textSize="15sp"
                    android:textColor="?attr/primaryText"
                    android:backgroundTint="@android:color/transparent"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:minHeight="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post a new volunteer opportunity"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/strokeColor"
            android:layout_marginStart="56dp"/>

        <!-- View Tasks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_task_list"
                android:tint="@color/colorPrimary"
                android:layout_marginEnd="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnVolunteers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View tasks"
                    android:textSize="15sp"
                    android:textColor="?attr/primaryText"
                    android:backgroundTint="@android:color/transparent"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:minHeight="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage open and active tasks"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/strokeColor"
            android:layout_marginStart="56dp"/>

        <!-- Chat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_chat"
                android:tint="@color/colorPrimary"
                android:layout_marginEnd="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnCreateSurvey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Messages"
                    android:textSize="15sp"
                    android:textColor="?attr/primaryText"
                    android:backgroundTint="@android:color/transparent"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:minHeight="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat with volunteers"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/strokeColor"
            android:layout_marginStart="56dp"/>

        <!-- Analytics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_analytics"
                android:tint="@color/colorPrimary"
                android:layout_marginEnd="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnViewAnalytics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analytics"
                    android:textSize="15sp"
                    android:textColor="?attr/primaryText"
                    android:backgroundTint="@android:color/transparent"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:minHeight="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Impact scores and task breakdowns"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/strokeColor"
            android:layout_marginStart="56dp"/>

        <!-- Completed Tasks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_check"
                android:tint="@color/colorPrimary"
                android:layout_marginEnd="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- NOTE: id is tvCompletedTasks - Button type kept as in original -->
                <Button
                    android:id="@+id/tvCompletedTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed tasks"
                    android:textSize="15sp"
                    android:textColor="?attr/primaryText"
                    android:backgroundTint="@android:color/transparent"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:minHeight="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Review finished volunteer work"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/strokeColor"
            android:layout_marginStart="56dp"/>

        <!-- History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:src="@drawable/ic_history"
                android:tint="@color/colorPrimary"
                android:layout_marginEnd="@dimen/spacing_md"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:textSize="15sp"
                    android:textColor="?attr/primaryText"
                    android:backgroundTint="@android:color/transparent"
                    android:textStyle="bold"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:minHeight="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full task activity log"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom spacing -->
        <View android:layout_width="match_parent" android:layout_height="@dimen/spacing_lg"/>

    </LinearLayout>
</ScrollView>