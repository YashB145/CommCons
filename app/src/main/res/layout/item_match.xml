<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeWidth="@dimen/card_stroke"
    app:strokeColor="?attr/strokeColor"
    app:cardBackgroundColor="?attr/cardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Title + Score row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Task Title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/primaryText"
                android:layout_marginEnd="@dimen/spacing_sm"/>

            <!-- Match score: color set by MatchActivity Kotlin -->
            <TextView
                android:id="@+id/tvMatchScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/sl_priority_low"
                android:fontFamily="serif"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="match score"
            android:textSize="10sp"
            android:textColor="?attr/secondaryText"
            android:layout_gravity="end"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <!-- Priority + Location row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/tvPriority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Priority: HIGH"
                android:textSize="12sp"
                android:textColor="@color/sl_priority_medium"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location"
                    android:tint="?attr/secondaryText"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="12sp"
                    android:textColor="?attr/secondaryText"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/strokeColor"
            android:layout_marginBottom="@dimen/spacing_sm"/>

        <!-- Required skills -->
        <TextView
            android:id="@+id/tvRequiredSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required: teaching, medical"
            android:textSize="13sp"
            android:textColor="?attr/secondaryText"
            android:layout_marginBottom="4dp"/>

        <!-- Matched skills -->
        <TextView
            android:id="@+id/tvMatchedSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You match: teaching"
            android:textSize="13sp"
            android:textColor="@color/sl_priority_low"/>

        <!-- Tap hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to view and accept"
            android:textSize="11sp"
            android:textColor="?attr/secondaryText"
            android:gravity="end"
            android:layout_marginTop="@dimen/spacing_sm"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>