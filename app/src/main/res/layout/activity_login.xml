<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/screenBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg"
        android:minHeight="600dp">

        <!-- Wordmark block - left aligned, no emoji hero -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SevaLink"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting communities through action."
            android:textSize="14sp"
            android:textColor="?attr/secondaryText"
            android:layout_marginBottom="48dp"/>

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:hint="Email address"
            android:textColorHint="?attr/mutedText"
            android:textColor="?attr/primaryText"
            android:textSize="15sp"
            android:inputType="textEmailAddress"
            android:paddingStart="@dimen/input_padding_h"
            android:paddingEnd="@dimen/input_padding_h"
            android:background="@drawable/rounded_input_light"
            android:layout_marginBottom="@dimen/spacing_md"/>

        <!-- Password -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:hint="Password"
            android:textColor="?attr/primaryText"
            android:textColorHint="?attr/mutedText"
            android:textSize="15sp"
            android:inputType="textPassword"
            android:paddingStart="@dimen/input_padding_h"
            android:paddingEnd="@dimen/input_padding_h"
            android:background="@drawable/rounded_input_light"
            android:layout_marginBottom="@dimen/spacing_lg"/>

        <!-- Sign in button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Sign in"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="@dimen/spacing_md"/>

        <!-- Create account button -->
        <Button
            android:id="@+id/btnGoToRegister"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Create account"
            android:textSize="15sp"
            android:textColor="@color/colorPrimary"
            android:backgroundTint="@android:color/transparent"
            android:layout_marginBottom="@dimen/spacing_md"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>