<?xml version="1.0" encoding="utf-8"?>
<!--
    SevaLink launcher icon — foreground
    A simple two-link chain motif: two overlapping rounded rectangles (rings)
    suggesting connection / seva (service). Flat, no gradient, deep green #1F5C4A.
    108×108dp viewport; safe zone is 72dp centred, so artwork sits inside ~54–72dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Left ring — centred at (44, 54), outer 28×18dp, stroke 6dp, rounded.
        Drawn as an annulus using evenOdd fill with an outer and inner rectangle.
    -->
    <path
        android:fillColor="#1F5C4A"
        android:pathData="
          M22,44
          Q22,36 30,36
          L50,36
          Q58,36 58,44
          L58,64
          Q58,72 50,72
          L30,72
          Q22,72 22,64
          Z
          M30,42
          Q28,42 28,44
          L28,64
          Q28,66 30,66
          L50,66
          Q52,66 52,64
          L52,44
          Q52,42 50,42
          Z"
        android:fillType="evenOdd" />

    <!--
        Right ring — centred at (64, 54), same size, overlapping the left ring
        to convey the "link / connection" motif.
    -->
    <path
        android:fillColor="#1F5C4A"
        android:pathData="
          M50,44
          Q50,36 58,36
          L78,36
          Q86,36 86,44
          L86,64
          Q86,72 78,72
          L58,72
          Q50,72 50,64
          Z
          M58,42
          Q56,42 56,44
          L56,64
          Q56,66 58,66
          L78,66
          Q80,66 80,64
          L80,44
          Q80,42 78,42
          Z"
        android:fillType="evenOdd" />

    <!--
        Accent bridge bar — saffron #E0902B — a small horizontal stroke connecting
        the two rings at centre, suggesting collaboration / joining.
    -->
    <path
        android:fillColor="#E0902B"
        android:pathData="M50,51 L58,51 Q60,51 60,54 Q60,57 58,57 L50,57 Q48,57 48,54 Q48,51 50,51 Z" />

</vector>
